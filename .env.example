# Shared env for local development. The API reads DATABASE_URL from the
# process environment — either export vars from this file at the repo root,
# or copy it to api/.env (api/.env is gitignored and should not be committed).
DATABASE_URL="postgresql://trackbench:trackbench@localhost:5432/trackbench?schema=public"
NUSCENES_DATAROOT="./data/raw/nuscenes"
NUSCENES_VERSION="v1.0-mini"
# mini scenes live in the train split of the Megvii release — use train, not val
DETECTIONS_JSON="./data/raw/detections/megvii_train.json"
NORMALIZED_ROOT="./data/normalized"
FIXTURES_ROOT="./data/fixtures"
PORT=3001
